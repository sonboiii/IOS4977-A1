rules_version = '2';

// Firestore security rules for the Municipal Elections Companion (COMP4977 Assignment 2).
// Paste these into Firebase console > Firestore Database > Rules, then Publish.
//
// The app signs in to Firebase Auth with the same email/password as the ASP.NET Core API,
// so request.auth.token.email identifies the user. Each user can only read, create,
// update or delete their own documents.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function isOwner(email) {
      return signedIn() && email == request.auth.token.email.lower();
    }

    function validSelection(data) {
      return data.userEmail is string
        && data.candidateId is int
        && data.candidateName is string && data.candidateName.size() > 0
        && data.positionName is string
        && data.municipalityName is string && data.municipalityName.size() > 0
        && data.notes is string && data.notes.size() <= 500;
    }

    match /CandidateSelections/{selectionId} {
      // Queries must filter on userEmail == the signed-in user's email, or they are rejected.
      // Reading a document that doesn't exist (the duplicate check before a create) reveals nothing.
      allow read: if signedIn() && (resource == null || isOwner(resource.data.userEmail));
      allow delete: if isOwner(resource.data.userEmail);
      allow create: if isOwner(request.resource.data.userEmail)
        && selectionId == request.resource.data.userEmail + '_' + string(request.resource.data.candidateId)
        && validSelection(request.resource.data);
      // The owner, candidate and municipality can't be changed by an update.
      allow update: if isOwner(resource.data.userEmail)
        && request.resource.data.userEmail == resource.data.userEmail
        && request.resource.data.candidateId == resource.data.candidateId
        && request.resource.data.municipalityName == resource.data.municipalityName
        && validSelection(request.resource.data);
    }

    match /UserProfiles/{email} {
      allow read, write: if isOwner(email);
    }
  }
}
